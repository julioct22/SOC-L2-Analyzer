    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.12.0",
    "fastify": "^5.12.8",
    "fastify-plugin": "^5.1.0",
    "fflate": "^0.8.3",
    "pg": "^8.23.1",
    "puppeteer-core": "^25.16.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@soc/shared": "1.0.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
