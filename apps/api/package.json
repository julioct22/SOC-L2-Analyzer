{
  "name": "@soc/api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST (Fastify) del SOC L2 Analyzer",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
