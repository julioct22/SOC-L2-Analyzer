# =============================================================
#  SOC L2 Analyzer - Variables de entorno
#  Copia este archivo a ".env" y cambia los valores marcados (!)
#  El archivo .env NO se sube a git (está en .gitignore).
# =============================================================

# ---------- Aplicación ----------
# Puerto donde se publica la web en tu máquina: http://localhost:8080
WEB_PORT=8080
# Zona horaria usada para mostrar fechas y nombrar carpetas (yyyy_mm_dd)
APP_TIMEZONE=America/Panama
# Nombre de la organización que aparece en el informe PDF
ORG_NAME=Organización Demo
# Tamaño máximo de archivo Excel (MB)
MAX_UPLOAD_MB=20
# Nivel de log del backend: fatal | error | warn | info | debug
LOG_LEVEL=info

# ---------- Base de datos PostgreSQL ----------
POSTGRES_USER=soc
# (!) Cambiar este valor
POSTGRES_PASSWORD=cambia_esta_clave_db
POSTGRES_DB=soc_l2
# Puerto local para conectarte con DBeaver/pgAdmin (solo escucha en 127.0.0.1)
DB_PORT=5432
# Solo para desarrollo local SIN Docker (yarn dev:api). En Docker se ignora:
# docker-compose.yml construye la URL apuntando al contenedor "db".
DATABASE_URL=postgres://soc:cambia_esta_clave_db@localhost:5432/soc_l2
DATA_DIR=./data

# ---------- Seguridad / sesiones ----------
# Secreto para firmar los tokens de sesión (MÍNIMO 32 caracteres o la API no arranca). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# (!) Cambiar este valor
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
# Duración de la sesión en horas
SESSION_HOURS=8
# true solo si sirves la app por HTTPS
COOKIE_SECURE=false

# ---------- Usuario administrador inicial ----------
# Se crea SOLO si la tabla de usuarios está vacía. Se pedirá cambiar la clave al primer login.
# Evita el carácter # en los valores (se interpreta como comentario) o encierra el valor entre comillas.
ADMIN_USERNAME=admin
# (!) Cambiar este valor
ADMIN_PASSWORD=Admin.2026!Cambiar
ADMIN_FULL_NAME=Administrador del Sistema

# ---------- Inteligencia Artificial ----------
# Proveedor: auto | anthropic | gemini | none
#   auto = usa Claude si hay ANTHROPIC_API_KEY; si no, Gemini si hay GEMINI_API_KEY; si no, sin IA.
# Sin IA el sistema funciona igual con textos deterministas del motor.
AI_PROVIDER=auto

# Opción gratuita: Google Gemini. Crea la clave en https://aistudio.google.com/apikey
# (plan gratuito con límites por minuto/día; Google puede usar esos datos para mejorar sus modelos)
GEMINI_API_KEY=
# Alias que apunta siempre al Flash más reciente. Si da error de cuota prueba: gemini-flash-lite-latest
GEMINI_MODEL=gemini-flash-latest

# Opción de pago: Claude (Anthropic). Clave en https://console.anthropic.com (prepago, aparte de claude.ai)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Máximo de tokens de salida para la redacción del informe
AI_MAX_TOKENS=8000
